ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 2
Hexadecimal [24-Bits]



                                      2 
                                      3 .area CSEG (CODE)
                                      4 
      000000                          5 rand_init:
                                      6 	; get values at rand_seed address
      000000 90 00 00         [24]    7 	mov dptr, #rand_seed
      000003 E0               [24]    8 	movx a, @dptr							; read high byte of rand_seed
      000004 C0 E0            [24]    9 	push a
      000006 A3               [24]   10 	inc dptr
      000007 E0               [24]   11 	movx a, @dptr							; read low byte of rand_seed
      000008 C0 E0            [24]   12 	push a
                                     13 	; use values to form new addresses
      00000A D0 82            [24]   14 	pop dpl
      00000C D0 83            [24]   15 	pop dph
      00000E E0               [24]   16 	movx a, @dptr							; read value at that address
      00000F C0 E0            [24]   17 	push a
                                     18 	; use this value to form two new addresses
      000011 C0 83            [24]   19 	push dph
      000013 C0 82            [24]   20 	push dpl
      000015 F5 83            [12]   21 	mov dph, a
      000017 E0               [24]   22 	movx a, @dptr							; read high byte of new seed
      000018 90 00 00         [24]   23 	mov dptr, #rand_seed
      00001B F0               [24]   24 	movx @dptr, a
      00001C D0 82            [24]   25 	pop dpl
      00001E D0 83            [24]   26 	pop dph
      000020 D0 82            [24]   27 	pop dpl
      000022 E0               [24]   28 	movx a, @dptr							; read low byte of new seed
      000023 90 00 01         [24]   29 	mov dptr, #(rand_seed + 1)
      000026 F0               [24]   30 	movx @dptr, a
      000027 22               [24]   31 	ret
                                     32 
      000028                         33 rand:
                                     34     ;; ---------------------------------------------------------
                                     35     ;; STEP 1: Multiplier 25173 (0x6255)
                                     36     ;; To compute (0x6255 * X) mod 65536 using 8-bit pieces:
                                     37     ;; Low product  = low(X) * 0x55
                                     38     ;; High product = [high(X) * 0x55] + [low(X) * 0x62]
                                     39     ;; ---------------------------------------------------------
                                     40 
                                     41     ;; Part A: low(X) * 0x55
      000028 90 00 01         [24]   42 	mov dptr, #(rand_seed+1)
      00002B E0               [24]   43     movx a, @dptr
      00002C 75 F0 55         [24]   44     mov     b, #0x55
      00002F A4               [48]   45     mul     ab                  ; A = low byte, B = high byte
      000030 FA               [12]   46     mov     r2, a               ; R2 = temporary low accumulator
      000031 AB F0            [24]   47     mov     r3, b               ; R3 = temporary high accumulator
                                     48 
                                     49     ;; Part B: high(X) * 0x55
      000033 90 00 00         [24]   50     mov	dptr, #(rand_seed)
      000036 E0               [24]   51 	movx a, @dptr
      000037 75 F0 55         [24]   52     mov     b, #0x55
      00003A A4               [48]   53     mul     ab                  ; A = low byte, B = high byte (B is discarded due to mod 65536)
      00003B 2B               [12]   54     add     a, r3               ; Add to high accumulator
      00003C FB               [12]   55     mov     r3, a
                                     56 
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 3
Hexadecimal [24-Bits]



                                     57     ;; Part C: low(X) * 0x62
      00003D 90 00 01         [24]   58 	mov dptr, #(rand_seed+1)
      000040 E0               [24]   59     movx a, @dptr
      000041 75 F0 62         [24]   60     mov     b, #0x62
      000044 A4               [48]   61     mul     ab                  ; A = low byte, B is discarded
      000045 2B               [12]   62     add     a, r3               ; Add to high accumulator
      000046 FB               [12]   63     mov     r3, a
                                     64 
                                     65     ;; ---------------------------------------------------------
                                     66     ;; STEP 2: Add Increment 13849 (0x3619)
                                     67     ;; ---------------------------------------------------------
      000047 EA               [12]   68     mov     a, r2
      000048 24 19            [12]   69     add     a, #0x19				; Add low byte of increment
      00004A 90 00 01         [24]   70 	mov dptr, #(rand_seed+1)
      00004D F0               [24]   71     movx @dptr, a					; Save final low byte to seed
      00004E F5 F0            [12]   72     mov     b, a					; Set return low byte
                                     73 
      000050 EB               [12]   74     mov     a, r3
      000051 34 36            [12]   75     addc    a, #0x36				; Add high byte + carry
      000053 90 00 00         [24]   76 	mov dptr, #(rand_seed)
      000056 F0               [24]   77 	movx @dptr, a					; Save final high byte to seed
                                     78 
      000057 C5 F0            [12]   79 	xch a, b						; Set return high byte
                                     80 
      000059 22               [24]   81     ret
                                     82 
      00005A                         83 get_seed:
      00005A 90 00 00         [24]   84 	mov dptr, #rand_seed
      00005D E0               [24]   85 	movx a, @dptr
      00005E F5 F0            [12]   86 	mov b, a
      000060 A3               [24]   87 	inc dptr
      000061 E0               [24]   88 	movx a, @dptr
      000062 22               [24]   89 	ret
                                     90 
                                     91 .area XSEG (XDATA)
                                     92 
      000000                         93 rand_seed:		.ds		0x02
