      000000                          7 vt102_clear_screen:
      000000 90 00 2D         [24]    8 	mov dptr, #VT102_CLEAR_SCREEN
      000003 12 00 00         [24]    9 	lcall sys_puts
      000006 22               [24]   10 	ret
