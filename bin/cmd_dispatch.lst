                                      7 .area CSEG (CODE)
                                      8 
                                      9 ; executes handler for command if found, otherwise executes invalid command handler
                                     10 ; --> dptr			address of command string to find
                                     11 ; <-- None
      000000                         12 cmd_dispatcher_exec:
      000000 AF 83            [24]   13 	mov R7, dph						; save address of command
      000002 AE 82            [24]   14 	mov R6, dpl
      000004 12 00 16         [24]   15 	lcall cmd_dispatcher_find		; find it in command table
      000007 A3               [24]   16 	inc dptr						; dptr contains address of entry of command or entry of invalid command
      000008 A3               [24]   17 	inc dptr						; advance 3 bytes to address of handler
      000009 A3               [24]   18 	inc dptr
                                     19 
      00000A E4               [12]   20 	clr a
      00000B 93               [24]   21 	movc a, @a + dptr
      00000C F9               [12]   22 	mov R1, a
      00000D 74 01            [12]   23 	mov a, #0x01
      00000F 93               [24]   24 	movc a, @a + dptr
      000010 C0 E0            [24]   25 	push a							; push low byte first
      000012 C0 01            [24]   26 	push 0x01						; push R1, high byte next
      000014 22               [24]   27 	ret								; dispatch command
                                     28 
      000015 22               [24]   29 	ret
                                     30 
                                     31 ; finds the entry for the specified command
                                     32 ; --> R7:R6		address of command to find
                                     33 ; <-- dptr		address of entry for found command, otherwise address of unknow command entry
                                     34 ; <-- C			set if found, otherwise clear
      000016                         35 cmd_dispatcher_find:
      000016 90 00 A9         [24]   36 	mov dptr, #cmd_dispatch_table
      000019                         37 cmd_dispatch_find_loop:
      000019 E4               [12]   38 	clr a
      00001A 93               [24]   39 	movc a, @a + dptr					; get id of command
      00001B 64 FF            [12]   40 	xrl a, #0xff						; compare to ff which is id of invalid command handler
      00001D 60 2D            [24]   41 	jz cmd_dispatch_find_exit			; dptr points to invalid cmd entry, exit
      00001F A9 83            [24]   42 	mov R1, dph							; save start of entry in table
      000021 A8 82            [24]   43 	mov R0, dpl
      000023 A3               [24]   44 	inc dptr							; points to command name in table
      000024 EF               [12]   45 	mov a, R7							; save address, strcmp will destroy it
      000025 FB               [12]   46 	mov R3, a
      000026 EE               [12]   47 	mov a, R6
      000027 FA               [12]   48 	mov R2, a
      000028 E4               [12]   49 	clr a								; get address of command name entry
      000029 93               [24]   50 	movc a, @a + dptr
      00002A FD               [12]   51 	mov R5, a							; get higher byte
      00002B 74 01            [12]   52 	mov a, #0x01
      00002D 93               [24]   53 	movc a, @a + dptr					; get lower byte
      00002E F5 82            [12]   54 	mov dpl, a
      000030 8D 83            [24]   55 	mov dph, R5
      000032 12 00 00         [24]   56 	lcall strcmp						; compare to command we are looking for
      000035 EB               [12]   57 	mov a, R3							; restore R7:R6
      000036 FF               [12]   58 	mov R7, a
      000037 EA               [12]   59 	mov a, R2
      000038 FE               [12]   60 	mov R6, a
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 9
