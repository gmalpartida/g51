      000039 40 0B            [24]   61 	jc cmd_dispatch_find_match			; match found
      00003B 89 83            [24]   62 	mov dph, R1							; restore start of entry address
      00003D 88 82            [24]   63 	mov dpl, R0
      00003F A3               [24]   64 	inc dptr							; move forward to next entry
      000040 A3               [24]   65 	inc dptr
      000041 A3               [24]   66 	inc dptr
      000042 A3               [24]   67 	inc dptr
      000043 A3               [24]   68 	inc dptr
      000044 80 D3            [24]   69 	sjmp cmd_dispatch_find_loop			; repeat
      000046                         70 cmd_dispatch_find_match:
      000046 D3               [12]   71 	setb c
      000047 89 83            [24]   72 	mov dph, R1							; restore address of entry, C is already set
      000049 88 82            [24]   73 	mov dpl, R0
      00004B 22               [24]   74 	ret
      00004C                         75 cmd_dispatch_find_exit:
      00004C C3               [12]   76 	clr c								; command not found, set C.  dptr points to unknown cmd entry
      00004D 22               [24]   77 	ret
