      000091 60 47            [24]  117 	jz uart_rx_asciz_exit						; if NULL then exit
      000093 64 0D            [12]  118 	xrl a, #0x0d
      000095 60 43            [24]  119 	jz uart_rx_asciz_exit						; if CR then exit
