      000042                         59 uart_rx_char_skip_dph:
      000042 F5 82            [12]   60 	mov dpl, a							; dptr contains address of char at buffer + head
      000044 E0               [24]   61 	movx a, @dptr						; retrieve character from buffer
      000045 C0 E0            [24]   62 	push acc							; save char
