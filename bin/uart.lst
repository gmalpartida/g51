      000099 64 0A            [12]  121 	xrl a, #0x0a
      00009B 60 3D            [24]  122 	jz uart_rx_asciz_exit						; if LF then exit
      00009D E5 F0            [12]  123 	mov a, b
      00009F 64 08            [12]  124 	xrl a, #BS									; check for BS
