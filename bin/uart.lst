      0000F0                        173 uart_rx_handler:
      0000F0 C2 98            [12]  174 	clr ri
      0000F2 E5 99            [12]  175 	mov a, sbuf							; retrieve received character
      0000F4 F5 F0            [12]  176 	mov b, a							; save it for later
      0000F6 90 00 01         [24]  177 	mov dptr, #uart_rx_buffer_tail
      0000F9 E0               [24]  178 	movx a, @dptr						; get tail position
      0000FA F8               [12]  179 	mov r0, a							; save buffer tail value
      0000FB 04               [12]  180 	inc a								; increment current buffer tail value
      0000FC F0               [24]  181 	movx @dptr, a						; save it back
      0000FD 90 00 00         [24]  182 	mov dptr, #uart_rx_buffer			; get address of rx buffer
      000100 E8               [12]  183 	mov a, r0							; restore buffer tail value
      000101 25 82            [12]  184 	add a, dpl							; add buffer tail value to buffer address
      000103 50 02            [24]  185 	jnc uart_rx_isr_skip_dph
      000105 05 83            [12]  186 	inc dph
