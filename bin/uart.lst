      00010B F0               [24]  190 	movx @dptr, a						; copy character to buffer
      00010C 90 00 02         [24]  191 	mov dptr, #uart_rx_buffer_count		; increment buffer count
      00010F E0               [24]  192 	movx a, @dptr
      000110 04               [12]  193 	inc a
      000111 F0               [24]  194 	movx @dptr, a
      000112 B4 C0 0A         [24]  195 	cjne a, #192, uart_rx_isr_exit		; buffer is not quite full yet
      000115 74 13            [12]  196 	mov a, #0x13						; send xoff
      000117 F5 99            [12]  197 	mov sbuf, a
