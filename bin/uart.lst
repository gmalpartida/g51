      000024                         40 uart_rx_char:
      000024 C0 82            [24]   41 	push dpl
      000026 C0 83            [24]   42 	push dph
                                     43 	; if buffer is not empty, process char
      000028 90 00 00         [24]   44 	mov dptr, #uart_rx_buffer_head
      00002B E0               [24]   45 	movx a, @dptr
      00002C F5 F0            [12]   46 	mov b, a							; save buffer head for later use
      00002E                         47 uart_rx_wait_loop:
      00002E 90 00 01         [24]   48 	mov dptr, #uart_rx_buffer_tail
      000031 E0               [24]   49 	movx a, @dptr						; read value of buffer tail
      000032 B5 F0 02         [24]   50 	cjne a, b, uart_rx_process_char		; compare to buffer head, if not the same then there is a char
      000035 80 F7            [24]   51 	sjmp uart_rx_wait_loop				; otherwise loop back and wait for char
      000037                         52 uart_rx_process_char:
                                     53 	; process char, store in a
      000037 90 00 00         [24]   54 	mov dptr, #uart_rx_buffer
      00003A E5 F0            [12]   55 	mov a, b							; restore buffer head
      00003C 25 82            [12]   56 	add a, dpl							; add head to buffer
      00003E 50 02            [24]   57 	jnc uart_rx_char_skip_dph
      000040 05 83            [12]   58 	inc dph
