      000022 12 00 00         [24]   45 	lcall asc2nibble
      000025 08               [12]   46 	inc r0
      000026 F5 F0            [12]   47 	mov b, a
      000028 E6               [12]   48 	mov a, @r0
      000029 12 00 00         [24]   49 	lcall asc2nibble
      00002C C4               [12]   50 	swap a
