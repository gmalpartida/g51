                                      6 .area CSEG (CODE)
                                      7 
      000000                          8 ahex2byte:
      000000 E0               [24]    9 	movx a, @dptr						; read upper nibble
      000001 12 00 00         [24]   10 	lcall asc2nibble
      000004 F5 F0            [12]   11 	mov b, a							; save it
      000006 A3               [24]   12 	inc dptr
      000007 E0               [24]   13 	movx a, @dptr						; read lower nibble
      000008 12 00 00         [24]   14 	lcall asc2nibble
      00000B C4               [12]   15 	swap a								
      00000C 54 F0            [12]   16 	anl a, #0xf0						; clear lower nibble
      00000E 45 F0            [12]   17 	orl a, b							; merge both nibbles
      000010 C4               [12]   18 	swap a								
      000011 22               [24]   19 	ret
                                     20 
      000012                         21 ahex2word:
      000012 12 00 00         [24]   22 	lcall ahex2byte
      000015 C0 E0            [24]   23 	push a								; store upper byte in stack
      000017 A3               [24]   24 	inc dptr
      000018 12 00 00         [24]   25 	lcall ahex2byte
      00001B D0 F0            [24]   26 	pop 0xf0							; pop upper byte onto b
      00001D 22               [24]   27 	ret									; return b:a
                                     28 
