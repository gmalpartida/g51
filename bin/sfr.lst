      000000                          8 print_sfr_table:
      000000 90 00 9B         [24]    9 	mov dptr, #sfr_table
      000003                         10 print_sfr_table_loop:
      000003 E4               [12]   11 	clr a
      000004 93               [24]   12 	movc a, @a + dptr			; sfr name
      000005 C5 F0            [12]   13 	xch a, b
      000007 A3               [24]   14 	inc dptr
      000008 E4               [12]   15 	clr a
      000009 93               [24]   16 	movc a, @a + dptr
      00000A C0 E0            [24]   17 	push a
      00000C 45 F0            [12]   18 	orl a, b					; last entry both bytes are 0
      00000E 60 36            [24]   19 	jz print_sfr_table_exit
      000010 D0 E0            [24]   20 	pop a
                                     21 
      000012 C0 82            [24]   22 	push dpl
      000014 C0 83            [24]   23 	push dph
      000016 F5 82            [12]   24 	mov dpl, a							; print sfr name
      000018 85 F0 83         [24]   25 	mov dph, b
      00001B 12 00 00         [24]   26 	lcall sys_puts
      00001E 12 00 00         [24]   27 	lcall printtab
      000021 D0 83            [24]   28 	pop dph
      000023 D0 82            [24]   29 	pop dpl
      000025 A3               [24]   30 	inc dptr							; advance to read sfr code
      000026 C0 82            [24]   31 	push dpl
      000028 C0 83            [24]   32 	push dph
      00002A 12 00 49         [24]   33 	lcall read_sfr						; read sfr content
      00002D 12 00 00         [24]   34 	lcall byte2asc						; print it
      000030 C5 F0            [12]   35 	xch a, b
      000032 12 00 00         [24]   36 	lcall sys_putc
      000035 C5 F0            [12]   37 	xch a, b
      000037 12 00 00         [24]   38 	lcall sys_putc
      00003A D0 83            [24]   39 	pop dph
      00003C D0 82            [24]   40 	pop dpl
                                     41 
      00003E 12 00 00         [24]   42 	lcall println
      000041 A3               [24]   43 	inc dptr
      000042 A3               [24]   44 	inc dptr
      000043 A3               [24]   45 	inc dptr
      000044 80 BD            [24]   46 	sjmp print_sfr_table_loop
